PORT=                # Port the Express server listens on (defaults to 4000)
MONGODB_URL=          # MongoDB connection string
JWT_SECRET=           # Secret used to sign/verify JWTs
CLIENT_URL=           # Frontend origin allowed by CORS (e.g. http://localhost:3000)
CLOUD_NAME=           # Cloudinary cloud name
API_KEY=              # Cloudinary API key
API_SECRET=           # Cloudinary API secret
FOLDER_NAME=          # Cloudinary upload folder name for course/profile media
MAIL_HOST=            # SMTP host used to send transactional email
MAIL_USER=            # SMTP username
MAIL_PASS=            # SMTP password
RAZORPAY_KEY=         # Razorpay key ID
RAZORPAY_SECRET=      # Razorpay key secret, used to verify payment signatures
